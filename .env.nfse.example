# ===========================================
# Credenciais Betha Fly Notas Dourados-MS
# ===========================================
# Substitua os valores entre <> pelos seus dados reais

# Credenciais do Portal Fly Notas
BETHA_USUARIO=seu_usuario_flynotas
BETHA_SENHA=sua_senha_flynotas

# Certificado Digital A1 (ICP-Brasil)
CERT_PATH=./certs/certificado.pfx
CERT_PASSWORD=senha_do_certificado

# Identificador da Prefeitura Dourados-MS (código IBGE)
# Código antigo: 5003402 | Código novo (verificado): 5003702
MUNICIPIO_CODIGO=5003702

# CNPJ do prestador (empresa emissor)
BETHA_CNPJ=13133714000110

# Endpoint NFSe Nacional DPS (Padrão Nacional)
# tpAmb=1 = Produção | tpAmb=2 = Homologação (suspensa até 01/09/2026)
# IMPORTANTE: A partir de 01/09/2026 será obrigatório Ambiente Nacional
BETHA_NFSE_DPS_URL=https://nota-eletronica.betha.cloud/dps/ws

# ===========================================
# MIGRAÇÃO: Ambiente Nacional (Emissor Nacional)
# Dourados-MS manteve o prazo de 01/09/2026.
# O Ambiente Nacional é REST/JSON (NÃO SOAP): POST /adn/DFe com
# {"LoteXmlGZipB64":["<gzip base64 do XML>"]}, autenticado por mTLS.
# O código roteia Betha -> Nacional via NFSE_EMISSAO.
# Mantenha 'betha' até testar o caminho nacional e só então troque para 'nacional'.
# ===========================================
NFSE_EMISSAO=betha

# Base do servico de EMISSAO (SEFIN Nacional). O codigo acrescenta /nfse e
# /nfse/{chave}/eventos. A emissao e sincrona (a resposta ja traz a NFS-e).
# Producao:  https://sefin.nfse.gov.br/SefinNacional
# Restrita:  https://sefin.producaorestrita.nfse.gov.br/SefinNacional
# (Preferencialmente, preencha isso em Configuracoes -> Config. NFSe no sistema.)
NACIONAL_NFSE_URL=https://sefin.nfse.gov.br/SefinNacional
# Namespace (targetNamespace) do XML DPS/Evento nacional (padrao oficial SPED).
NACIONAL_DPS_NS=http://www.sped.fazenda.gov.br/nfse
# Nome do elemento-raiz do evento de cancelamento.
NACIONAL_OP_CANCELA=RecepcionarEventoCancelamentoEnvio
# Identificador do seu sistema no Ambiente Nacional (verAplic). CONFIRMAR.
NACIONAL_VER_APPLIC=
# Versão do schema DPS (padrão 1.01 conforme anexos do Ambiente Nacional).
NACIONAL_DPS_VERSAO=1.01
# Token opcional (mTLS com o certificado A1 do emissor geralmente basta).
NACIONAL_TOKEN=